# =============================================================================
# Dependency Exit Capsule - Environment Configuration
# =============================================================================
# Copy this file to .env and insert your API key:
#   cp .env.example .env

# Option 1: Groq (Recommended - High speed, open-weight models, free tier)
GROQ_API_KEY=

# Option 2: Generic OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter)
# DEC_PROVIDER=openai
# DEC_BASE_URL=https://api.groq.com/openai/v1
# DEC_MODEL=llama-3.3-70b-versatile
# DEC_API_KEY=gsk_...

# Option 3: Local Ollama (No API key needed)
# DEC_PROVIDER=ollama
# DEC_BASE_URL=http://localhost:11434
# DEC_MODEL=qwen2.5-coder:7b
