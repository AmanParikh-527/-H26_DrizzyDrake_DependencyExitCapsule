# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environments and Secrets
.env
.env.local
.venv/
venv/
ENV/

# Scratch & Temporary directories
out/
scratch/
*.log

# Keep target folder structure, ignore arbitrary cloned target repos except LinkWatch sample
dependency-exit-capsule/target/*
!dependency-exit-capsule/target/.gitkeep
!dependency-exit-capsule/target/README.md
!dependency-exit-capsule/target/LinkWatch/
!dependency-exit-capsule/target/LinkWatch/**

# Keep capsule_output directory structure
capsule_output/*
!capsule_output/.gitkeep
!capsule_output/intermediate/
capsule_output/intermediate/*
!capsule_output/intermediate/.gitkeep
